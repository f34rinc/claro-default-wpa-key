# Never commit captured handshakes — they are real credential material.
*.hc22000
*.22000
*.pcap
*.pcapng
*.cap
*.hccapx

# Local scratch for fabricated test captures — never published, even though fake.
samples/

# utils/ doubles as a local scratchpad for hashcat testing — stray capture/scratch
# files land there (handshake lines pasted into a .txt, dumps, exports). Only source
# is tracked (charset_mask.py), so ignoring these data/scratch types never hits a .py.
# (*.hc22000/.pcap/.log etc. are already covered globally above.)
utils/*.txt
utils/*.csv
utils/*.out
utils/*.tmp
utils/*.dat

# hashcat artifacts
*.potfile
hashcat.potfile
*.restore
*.log

# recovered keys written by claro_wpa_key.py — real credential material.
# The crack log is JSONL now; match it by name AND by format. This repo ships
# no .json/.jsonl of its own, so the broad rules are safe — if a legitimate
# config/data JSON is ever added, force it in with `git add -f <file>`.
claro_cracked.txt
claro_cracked.jsonl
*cracked*.txt
*cracked*.jsonl
*.jsonl
*.json

# WiGLE wardriving exports carry a per-AP GPS fix — keep local, never publish.
# (data/claro_ouis.csv is intentionally NOT matched by these.)
*.kml
*.kmz
wigle*.csv
WigleWifi*.csv
# analyze_wigle.py reports may list real BSSID+SSID pairs
wigle_report*.txt
*_wigle_report.txt

